# SafeKids — contoh konfigurasi Supabase (MODE DEMO)
#
# Aplikasi jalan TANPA file ini: kalau variabel di bawah kosong, aplikasi
# memakai placeholder dan semua fitur lokal (simulasi 3D, kuis, refleksi,
# team maker) tetap berfungsi. Login guru + sinkronisasi data kelas ke
# Supabase hanya aktif kalau kredensial proyek sendiri diisi di sini.
#
# JANGAN commit file .env berisi kredensial nyata. Salin file ini ke
# .env.local lalu isi dengan kredensial proyek Supabase sendiri.
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder
